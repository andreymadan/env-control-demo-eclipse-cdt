@echo off
REM Shared configuration for the Parasoft C/C++test command-line scripts in this folder.
REM Override any variable by setting it in the environment before invoking a script.

if not defined CPPTESTCLI_EXE set "CPPTESTCLI_EXE=C:\Apps\Parasoft\professional\cpptest\cpptestcli.exe"
if not defined CPPTEST_DATA set "CPPTEST_DATA=C:\sandbox\workspaces\2024_2"
if not defined CPPTEST_PROJECT set "CPPTEST_PROJECT=env-control-demo-eclipse-cdt"
if not defined CPPTEST_UT_CONFIG set "CPPTEST_UT_CONFIG=toolsettings\RunUnitTests-allcov.properties"
if not defined CPPTEST_SETTINGS set "CPPTEST_SETTINGS=toolsettings\settings4cli.properties"

REM The Test Configuration has test generation enabled (com.parasoft.xtest.testgen.api.enabled=true),
REM which would otherwise re-create tests\autogenerated\ on every execution run. Disable it here so
REM routine test runs only execute existing suites; override/clear this variable to re-enable generation.
if not defined CPPTEST_DISABLE_GEN_PROPERTY set "CPPTEST_DISABLE_GEN_PROPERTY=-property com.parasoft.xtest.testgen.api.enabled=false"
