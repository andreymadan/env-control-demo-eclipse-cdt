@echo off
REM Runs one or more specific generated TestSuite_*.c files directly.
REM
REM Usage:
REM   RunUnitTests_TestSuites.bat <testsuite1> [testsuite2] ...
REM   RunUnitTests_TestSuites.bat <list.lst>
REM
REM   Each testsuiteN is a path relative to tests\autogenerated, e.g.
REM     src\TestSuite_actuator_manager_c.c
REM     drivers\TestSuite_fan_driver_c.c
REM   A single .lst file is passed straight to cpptestcli; it must contain one resource per
REM   line, each already fully qualified, e.g.
REM     env-control-demo-eclipse-cdt/tests/autogenerated/src/TestSuite_actuator_manager_c.c
REM   (this is cpptestcli's native -resource list-file format, see the -resource option docs).
setlocal enabledelayedexpansion
call "%~dp0common.bat"
pushd "%~dp0.."

if "%~1"=="" (
    echo Usage: %~nx0 ^<testsuite1^> [testsuite2] ...
    echo    or: %~nx0 ^<list.lst^>
    popd
    exit /b 1
)

set "RESOURCE_ARGS="

if /I "%~x1"==".lst" (
    set "RESOURCE_ARGS=-resource "%~1""
) else (
    for %%F in (%*) do (
        set "ITEM=%%~F"
        set "ITEM=!ITEM:\=/!"
        set "RESOURCE_ARGS=!RESOURCE_ARGS! -resource "%CPPTEST_PROJECT%/tests/autogenerated/!ITEM!""
    )
)

"%CPPTESTCLI_EXE%" -config "%CPPTEST_UT_CONFIG%" -report UT_REPORTS_TESTSUITES -settings "%CPPTEST_SETTINGS%" !RESOURCE_ARGS! -data "%CPPTEST_DATA%" %CPPTEST_DISABLE_GEN_PROPERTY%
set "EXITCODE=%ERRORLEVEL%"

REM The Test Configuration's test generator does not recognize the project's one-function-per-TestSuite
REM convention as "up to date", so it recreates tests\autogenerated\ on every run. Remove it to keep
REM the tests\ tree matching the tests\<module>_tests\ convention (see the parasoft-unit-testing skill).
if exist tests\autogenerated rmdir /s /q tests\autogenerated

popd
exit /b %EXITCODE%
